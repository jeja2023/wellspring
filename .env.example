# 本机开发 PostgreSQL 连接；复制为 .env 并按实际环境调整。
WELLSPRING_DB_HOST=127.0.0.1
WELLSPRING_DB_PORT=5432
WELLSPRING_DB_NAME=wellspring
WELLSPRING_DB_USER=wellspring
WELLSPRING_DB_PASSWORD=

# OpenAI 兼容服务：由“模型服务”页面配置根地址和模型，密钥只留服务端。
WELLSPRING_AI_ALLOWED_HOSTS=localhost,127.0.0.1,::1,host.docker.internal
WELLSPRING_AI_API_KEY=
# 与 WELLSPRING_AI_API_KEY 二选一；可以使用包外受控的 UTF-8 单行密钥文件。
# WELLSPRING_AI_API_KEY_FILE=C:/wellspring/secrets/ai_api_key
# 页面保存 API Key 的服务端目录（默认 backend/.secrets）；应限制目录访问并随配置备份。
# WELLSPRING_AI_SECRET_DIR=C:/wellspring/secrets/model-credentials
# 离线地图：WGS84 经纬度、EPSG:3857 / XYZ 的 256×256 PNG 瓦片目录。
# 未配置时使用坐标视图，不连接公网地图；支持路径中包含空格。
WELLSPRING_MAP_TILE_DIR=
WELLSPRING_MAP_ATTRIBUTION=本地授权底图
