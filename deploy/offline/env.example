# 先复制到安全位置，再填写。不得将真实密码写入本文件。
# 默认仅允许宿主机本地访问；确需内网访问时改为已批准的内网 IP。
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
SECRETS_DIR=/srv/wellspring/secrets
APP_IMAGE=wellspring/app:0.0.7
# 镜像须先通过离线包校验；存储路径按 PostgreSQL 17 镜像设计。
POSTGRES_IMAGE=wellspring/postgres:17-offline

# 模型服务主机允许名单；Docker 默认仅连容器网络或宿主机。
AI_ALLOWED_HOSTS=localhost,127.0.0.1,::1,host.docker.internal
# 需要鉴权时通过构建包外的受控环境注入 AI_API_KEY；不要把真实密钥写入示例。
# 文件密钥可用 Compose override 单独挂载，再设置 WELLSPRING_AI_API_KEY_FILE。
# 已向 wellspring_map_tiles 卷导入授权底图后，设置为 /app/map-tiles。
MAP_TILE_DIR=
MAP_ATTRIBUTION=本地授权底图
MAP_TILE_CRS=WGS84
MAP_MIN_ZOOM=0
MAP_MAX_ZOOM=20
MAP_CENTER=120.297066,31.576634
MAP_INITIAL_ZOOM=13
